{
  "name": "threejs-autocomplete",
  "displayName": "Three.js Autocomplete",
  "description": "Автодополнение для библиотеки Three.js",
  "icon": "images/LogoIcon.jpg",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.97.0"
  },
  "publisher": "MaxProgrammerComputer",
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "threejs-autocomplete.showInfo",
        "title": "Three.js: Показать информацию о расширении"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.97.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Maksim2021-whiteHAKER/threejs-autocomplete"
  },
  "dependencies": {
    "@babel/parser": "^7.27.0"
  }
}
